!AASM 1.0.0

!target {
    vm      ^1.0.0
    isa     ^1.0.0
}

!namespace avm_sample
!entry main

!capabilities {
    stdio
}

!batteries {
    adnan.stdio
}

!code {
    main {
        !reg_aliases {
            NUM_ARR R0
        }

        CARRR .NUM_ARR TYP/I32 /8
        PUSHEL .NUM_ARR /9
        PUSHEL .NUM_ARR /1
        PUSHEL .NUM_ARR /-4
        PUSHEL .NUM_ARR /53
        PUSHEL .NUM_ARR /-78
        PUSHEL .NUM_ARR /17
        PUSHEL .NUM_ARR /12
        PUSHEL .NUM_ARR /-8

        CALL .ZR /NULL selection_sort .NUM_ARR
    }

    selection_sort ARR%a {
        !reg_aliases {
            LEN                 R0
            I                   R1
            J                   R2
            CONTINUE_OUTER_LOOP R3
            CONTINUE_INNER_LOOP R4
            MIN_INDEX           R5
            MIN_VALUE           R6
            MIN_CHECK_TEMP      R7
            NEW_MIN_FOUND       R8
        }

        ARRLEN .LEN %a

        COP .I /0

        :outer_loop
        ILT .CONTINUE_OUTER_LOOP .I .LEN
        JMPF :ret .CONTINUE_OUTER_LOOP

        COP .MIN_INDEX .I
        GETEL .MIN_VALUE %a .I

        COP .J .I
        IINC .J
        IINC .I

        :inner_loop
        ILT .CONTINUE_INNER_LOOP .J .LEN
        JMPF :outer_loop_end .CONTINUE_INNER_LOOP

        GETEL .MIN_CHECK_TEMP %a .J

        ILT .NEW_MIN_FOUND .MIN_CHECK_TEMP .MIN_VALUE
        JMPF :inner_loop_end .NEW_MIN_FOUND

        COP .MIN_INDEX .J
        COP .MIN_VALUE .MIN_CHECK_TEMP

        :inner_loop_end
        IINC .J
        JMP :inner_loop

        :outer_loop_end
        CALL .ZR /NULL swap_array_elements %a .I .MIN_INDEX
        JMP :outer_loop

        :ret
        RET /NULL
    }

    swap_array_elements ARR%a %i %j {
        !reg_aliases {
            LEN             R0
            INVALID_RANGE   R1
            TMP_1           R2
        }

        ARRLEN .LEN %a

        ILT .INVALID_RANGE %i /0
        JMPT :invalid_range_exception .INVALID_RANGE

        ILE .INVALID_RANGE .LEN $j
        JMPT :invalid_range_exception .INVALID_RANGE

        GETEL .TMP_1 %a %i
        GETEL .TMP_2 %a %j

        SETEL %a %i .TMP_2
        SETEL %a %j .TMP_1

        JMP :ret

        :invalid_range_exception
        THROW /0

        :ret
        RET
    }
}