!AASM 1.0.0

!target {
    vm      ^1.0.0
    isa     ^1.0.0
}

!namespace avm_sample
!entry main

!capabilities {
    stdio
}

!batteries {
    adnan.stdio
}

!code {
    main {
        !reg_aliases {
            NUM_ARR R0
            RESULT  R1
        }

        CARRR .NUM_ARR TYP/I32 /4
        PUSHEL .NUM_ARR /21
        PUSHEL .NUM_ARR /-5
        PUSHEL .NUM_ARR /7
        PUSHEL .NUM_ARR /-2

        CALL .RESULT array_sum .NUM_ARR
        HOSTCALL .ZR /NULL adnan.stdio.println .RESULT
    }

    array_sum ARR%a {
        !reg_aliases {
            SUM     R0
            LEN     R1
            I       R2
            CHECK   R3
            TMP     R4
        }

        COP .SUM /0
        ARRLEN .LEN %a
        COP .I /0

        :loop
        ILT .CHECK .I .LEN
        JMPF :end .CHECK

        GETEL .TMP %a .I
        IADD .SUM .SUM .TMP
        IINC .I
        JMP :loop

        :end
        RET .SUM
    }
}